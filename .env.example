# Copy to .env and supply your own values. Never commit .env.
MONGODB_URL=mongodb://127.0.0.1:27017/campus
JWT_KEY=
FRONTEND_URL=http://localhost:5173
PORT=3000
# Must be persistent storage on the deployed backend.
UPLOAD_DIR=./uploads
# Required for registration verification, password reset and applicant email.
EMAIL_USER=
EMAIL_PASS=
# Optional: password login remains available without Google configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: deletion of historical CVs stored in the existing Supabase cv bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
