# Copy to .env and supply your own values. Never commit .env.
MONGODB_URL=mongodb://127.0.0.1:27017/campus
JWT_KEY=
FRONTEND_URL=http://localhost:5173
PORT=3000
# Migration source only for previously saved local files. Not used by live uploads/downloads.
UPLOAD_DIR=./uploads
# Required for registration verification, password reset and applicant email.
RESEND_API_KEY=
# Use a sender on a domain verified in Resend. This address is for testing only.
RESEND_FROM=onboarding@resend.dev
# Optional: password login remains available without Google configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required backend-only Supabase storage credentials. Never put the service key in VITE_ variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set production on the deployed backend; startup validates the configuration.
NODE_ENV=development
# Comma-separated exact frontend origins. Defaults to FRONTEND_URL.
CORS_ORIGINS=http://localhost:5173
# Set only to the exact number of trusted reverse proxies; leave blank otherwise.
TRUST_PROXY_HOPS=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/users/auth/google/callback

# New photos and application ZIPs are stored in private Supabase buckets.
SUPABASE_AVATARS_BUCKET=im
SUPABASE_DOCUMENTS_BUCKET=cv
